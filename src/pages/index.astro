---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const SITE_NAME = import.meta.env.SITE_NAME || 'Sean';
const TAGLINE = import.meta.env.SITE_TAGLINE || '记录软件工程、独立开发与真实产品背后的判断。';
const INTRO =
  import.meta.env.SITE_INTRO ||
  '这里不追逐短暂的技术热度，只讨论经得起实践检验的方法、系统与长期主义。';
const GITHUB = import.meta.env.GITHUB_URL || 'https://github.com/Seann0824';
const EMAIL = import.meta.env.EMAIL || 'sean@englife.space';

const posts = await getPosts();
const pinned = posts.find((post) => post.data.pinned === true) ?? posts[0];
const recent = posts.filter((post) => post.id !== pinned?.id);
---
<BaseLayout title={SITE_NAME}>
  <section id="hero" class="border-b border-border pt-12 pb-10 sm:pt-16 sm:pb-12">
    <div class="flex items-start justify-between gap-4">
      <h1 class="hero-title">{SITE_NAME} 的工程实践笔记</h1>
      <a
        href="/rss.xml"
        class="hero-rss mt-2 inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <svg
          class="size-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M5 18.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0Z"></path>
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>
    </div>

    <p class="hero-intro">{TAGLINE}{INTRO}</p>
    <p class="hero-meta">持续写作&nbsp;&nbsp;·&nbsp;&nbsp;共 {posts.length} 篇</p>

    <div class="hero-socials mt-5 flex max-sm:flex-col sm:items-center">
      <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">找到我:</div>
      <div class="flex flex-wrap items-center gap-1">
        <a
          href={GITHUB}
          rel="noopener"
          target="_blank"
          title={`${SITE_NAME} on Github`}
          class="inline-flex items-center gap-1 p-2 sm:p-1"
        >
          <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.4 9.4 0 0 1 2.5-.34c.85 0 1.71.12 2.5.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.8-4.58 5.05.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.06 10.06 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
            ></path>
          </svg>
          <span class="sr-only">{SITE_NAME} on Github</span>
        </a>
        <a
          href={`mailto:${EMAIL}`}
          title={`Send an email to ${SITE_NAME}`}
          class="inline-flex items-center gap-1 p-2 sm:p-1"
        >
          <svg
            class="size-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
            <path d="m3.5 7 8.5 6 8.5-6"></path>
          </svg>
          <span class="sr-only">Send an email to {SITE_NAME}</span>
        </a>
      </div>
    </div>
  </section>

  {pinned && (
    <section id="featured" class="border-b border-border pt-12 pb-6">
      <h2 class="section-title">置顶文章</h2>
      <PostList posts={[pinned]} />
    </section>
  )}

  <section id="recent-posts" class="pt-12 pb-6">
    <h2 class="section-title">最近更新</h2>
    <PostList posts={recent} />
  </section>

  <p class="py-8 text-sm text-muted-foreground">
    所有文章都在飞书里写，同步后自动构建。
    <a class="text-accent hover:underline" href="/posts/">查看全部 →</a>
  </p>
</BaseLayout>
