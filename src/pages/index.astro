---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// 首页 hero 的个人资料与履历（和紙主题里当作「履歴書」来排：左栏年份、右栏经历）
const profile = {
  name: "肖元彪",
  en: "Sean",
  role: "前端工程师 · AI 应用与 Agent 方向",
  place: "深圳",
};

const career = [
  {
    period: "2026.01 — 2026.10",
    org: "字节跳动 · TikTok Ads",
    role: "前端工程师",
    place: "深圳",
  },
  {
    period: "2023.07 — 2025.12",
    org: "蓝湖 · MasterGo",
    role: "前端工程师",
    place: "北京",
  },
  {
    period: "2019 — 2023",
    org: "内蒙古科技大学",
    role: "软件工程 · 本科",
    place: "包头",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border relative border-b pt-14 pb-12">
      <span
        aria-hidden="true"
        class="tategaki text-accent/60 pointer-events-none absolute inset-e-1 top-14 hidden text-[0.7rem] tracking-[0.55em] sm:block"
      >
        経歴
      </span>

      <p
        class="text-muted-foreground font-gothic text-[0.65rem] tracking-[0.4em] uppercase"
      >
        profile
      </p>
      <h1 class="mt-5 text-3xl font-semibold tracking-[0.18em] sm:text-4xl">
        {profile.name}
        <span
          class="text-muted-foreground ms-2 text-base font-normal tracking-[0.2em]"
        >
          / {profile.en}
        </span>
      </h1>
      <p
        class="text-muted-foreground font-gothic mt-4 text-xs tracking-[0.14em]"
      >
        {profile.role} · {profile.place}
      </p>

      <div class="mt-8 max-w-xl space-y-4 leading-[1.95]">
        <p>
          做过设计工具，也做过广告系统。在蓝湖 MasterGo 负责 MasterGo Agent、MCP
          Server 与开发者工具，包括那套用 Rust 重写的本地字体服务插件——安装包
          65MB 压到 3MB，启动从 10 秒到 1 秒；后来在字节跳动 TikTok Ads
          做素材库与创编流程。
        </p>
        <p class="text-foreground/80">
          现在想做的是 AI 应用与 Agent
          方向的产品工程：自己用 Rust 从零写过一套 agent runtime，也还在继续写。这里主要记下这些过程里的取舍。
        </p>
      </div>

      <dl class="border-border mt-10 border-t">
        {
          career.map(({ period, org, role, place }) => (
            <div class="border-border grid grid-cols-1 gap-1 border-b py-4 sm:grid-cols-[8.5rem_1fr] sm:gap-5">
              <dt class="text-muted-foreground font-gothic text-[0.7rem] tracking-[0.12em] sm:pt-1">
                {period}
              </dt>
              <dd>
                <p class="font-medium tracking-[0.02em]">{org}</p>
                <p class="text-muted-foreground mt-1 text-xs tracking-[0.06em]">
                  {role} · {place}
                </p>
              </dd>
            </div>
          ))
        }
      </dl>

      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="text-muted-foreground hover:text-accent font-gothic mt-8 inline-flex items-center gap-2 text-[0.7rem] tracking-[0.3em] uppercase transition-colors"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={14}
          height={14}
          class="stroke-accent scale-125 stroke-2 rtl:-rotate-90"
        />
        RSS
      </a>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 text-sm whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-16 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="font-gothic text-muted-foreground mb-1 text-[0.7rem] tracking-[0.35em]">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-16 pb-6">
          <h2 class="font-gothic text-muted-foreground mb-1 text-[0.7rem] tracking-[0.35em]">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-14 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="font-gothic text-[0.72rem] tracking-[0.3em]"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
