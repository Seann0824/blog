---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border relative border-b pt-14 pb-12">
      <span
        aria-hidden="true"
        class="tategaki text-accent/60 pointer-events-none absolute inset-e-1 top-14 hidden text-[0.7rem] tracking-[0.55em] sm:block"
      >
        日々の記録
      </span>

      <p
        class="text-muted-foreground font-gothic text-[0.65rem] tracking-[0.4em] uppercase"
      >
        washi
      </p>
      <h1
        class="mt-5 text-3xl font-semibold tracking-[0.18em] sm:text-4xl"
      >
        {site.title}
      </h1>

      <p class="mt-7 leading-[1.95]">{site.description}</p>
      <p class="text-foreground/70 mt-3 text-[0.95rem] leading-[1.9]">
        关于代码、产品，和一些没什么用但想记下来的事。
      </p>

      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="text-muted-foreground hover:text-accent font-gothic mt-8 inline-flex items-center gap-2 text-[0.7rem] tracking-[0.3em] uppercase transition-colors"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss width={14} height={14} class="stroke-accent scale-125 stroke-2 rtl:-rotate-90" />
        RSS
      </a>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 text-sm whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-16 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="font-gothic text-muted-foreground mb-1 text-[0.7rem] tracking-[0.35em]">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-16 pb-6">
          <h2 class="font-gothic text-muted-foreground mb-1 text-[0.7rem] tracking-[0.35em]">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-14 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="font-gothic text-[0.72rem] tracking-[0.3em]"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
