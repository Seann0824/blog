---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return Array.from(tags.entries()).map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;
---
<BaseLayout title={`标签：${tag}`} description={`标签 ${tag} 下的全部文章`}>
  <section class="border-b border-border pt-12 pb-10">
    <h1 class="hero-title">标签：{tag}</h1>
    <p class="hero-meta">共 {posts.length} 篇</p>
  </section>

  <section class="py-4">
    <PostList posts={posts} />
    <p class="py-8">
      <a class="tag-pill" href="/tags/">← 全部标签</a>
    </p>
  </section>
</BaseLayout>
