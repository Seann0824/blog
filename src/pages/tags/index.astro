---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/posts';

const tags = await getAllTags();
---
<BaseLayout title="标签" description="按标签浏览全部文章">
  <section class="border-b border-border pt-12 pb-10">
    <h1 class="hero-title">标签</h1>
    <p class="hero-meta">共 {tags.size} 个</p>
  </section>

  <section class="py-10">
    {tags.size === 0 ? (
      <p class="text-muted-foreground">还没有标签。在飞书文档里给文章加上 tags 即可。</p>
    ) : (
      <ul class="flex flex-wrap gap-2">
        {Array.from(tags.entries()).map(([tag, items]) => (
          <li>
            <a class="tag-pill" href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
              <span class="ms-2 text-xs text-muted-foreground">{items.length}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
