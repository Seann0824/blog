---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<button
  data-button="back-to-top"
  class="text-muted-foreground hover:text-accent inline-flex items-center gap-1.5 text-[0.72rem] tracking-[0.2em] transition-colors"
>
  <IconArrowNarrowUp class="size-3.5" />
  {t.post.backToTop}
</button>

<script is:inline data-astro-rerun>
  function backToTop() {
    const btn = document.querySelector("[data-button='back-to-top']");
    if (!btn) return;
    btn.addEventListener("click", () => {
      // 滚动发生在 #main-content 上，不是 window
      const scroller = document.getElementById("main-content");
      if (scroller) scroller.scrollTo({ top: 0, behavior: "instant" });
      else window.scrollTo({ top: 0, behavior: "instant" });
    });
  }
  backToTop();
</script>
