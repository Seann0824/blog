---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { projects } from "@/data/projects";

/**
 * 项目页：信息结构参考 antfu.me/projects，视觉全走本站 token。
 * 两列卡片而非三列 —— 条目只有 6 个，三列会把每张卡压得又窄又空；
 * 两列下每张卡有足够宽度放一整句话的说明，行数也刚好三排，版面更稳。
 */
const title = "项目";
const description =
  "Sean 做过的产品与开源项目：Rust agent 框架 Shirley、Codex/MCP 工具、TubeGate 与这个博客。";
---

<Layout
  title={`${title} | ${config.site.title}`}
  description={description}
  canonicalURL={new URL(Astro.url.pathname, Astro.site).href}
>
  <Header />

  <Breadcrumb />

  <main id="main-content" class="app-scroll">
    <div class="app-layout pb-10">
      <section class="mb-8" aria-labelledby="projects-title">
        <h1
          id="projects-title"
          class="text-2xl font-semibold tracking-[0.03em] sm:text-3xl"
        >
          {title}
        </h1>
        <p
          class="text-pretty mt-3 max-w-[34em] leading-relaxed text-muted-foreground"
        >
          能点开的都在这儿：自己写的工具、开源项目，和跑在线上的东西。
        </p>
      </section>

      <ul class="grid gap-4 sm:grid-cols-2">
        {
          projects.map(project => (
            <li class="flex">
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="focus-outline group flex w-full flex-col rounded-lg border border-border p-5 transition-colors hover:border-accent"
              >
                <div class="flex items-baseline justify-between gap-3">
                  <h2 class="text-base font-medium tracking-[0.02em] transition-colors group-hover:text-accent">
                    {project.name}
                  </h2>
                  <span
                    aria-hidden="true"
                    class="shrink-0 text-xs text-muted-foreground transition-colors group-hover:text-accent"
                  >
                    ↗
                  </span>
                </div>

                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  {project.desc}
                </p>

                {project.meta && (
                  <p class="font-gothic mt-3.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.7rem] tracking-[0.1em] text-muted-foreground/70">
                    {project.meta.map((tag, i) => (
                      <span class="flex items-center gap-3">
                        {i > 0 && <span aria-hidden="true" class="opacity-40">/</span>}
                        {tag}
                      </span>
                    ))}
                  </p>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer />
</Layout>
