---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** 文章页传 true，标题就不再拼站点名 */
  bare?: boolean;
  ogType?: 'website' | 'article';
}

const SITE_NAME = import.meta.env.SITE_NAME || 'Sean';
const { title, description = '', bare = false, ogType = 'website' } = Astro.props;

const pageTitle = bare ? title : title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const desc = description || '关于软件工程、独立开发与长期主义的实践笔记。';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="zh-CN" class="overflow-y-scroll scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
    <!-- 主题色跟随亮暗，移动端状态栏不突兀 -->
    <meta name="theme-color" content="#fdfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1b19" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // 绘制前定好主题，避免闪白；存储值优先，其次跟随系统
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
          var root = document.documentElement;
          root.setAttribute('data-theme', theme);
          root.classList.toggle('dark', theme === 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-svh flex-col">
    <Header />
    <main id="main-content" class="app-layout flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        // 主题切换
        var toggle = document.getElementById('theme-toggle');
        if (toggle) {
          toggle.addEventListener('click', function () {
            var root = document.documentElement;
            var current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
            var next = current === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            root.classList.toggle('dark', next === 'dark');
            try {
              localStorage.setItem('theme', next);
            } catch (e) {}
          });
        }

        // 移动端菜单
        var btn = document.getElementById('menu-btn');
        var items = document.getElementById('menu-items');
        if (btn && items) {
          btn.addEventListener('click', function () {
            var open = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', open ? 'false' : 'true');
            btn.setAttribute('aria-label', open ? '打开菜单' : '关闭菜单');
            items.classList.toggle('hidden');
            items.classList.toggle('grid');
          });
        }
      })();
    </script>
  </body>
</html>
