---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="my-8 text-muted-foreground">
    还没有文章。在飞书里写一篇，然后跑 <code>npm run sync</code>。
  </p>
) : (
  <ul>
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </ul>
)}
