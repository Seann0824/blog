---
import { postDate, postTags, postHref, formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;

const date = postDate(post);
const tags = postTags(post);

// 摘要优先用 frontmatter 的 description，否则取正文第一段纯文本
const rawBody = (post.body ?? '').replace(/^---[\s\S]*?---/, '');
const firstParagraph = rawBody
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .find((block) => block && !block.startsWith('#') && !block.startsWith('```') && !block.startsWith('!['));
const excerpt = (post.data.description || firstParagraph || '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#>*_`~]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 96);
---
<li class="post-card my-6">
  <div class="post-card-content">
    <a
      href={postHref(post)}
      class="inline-block text-lg font-medium text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
    >
      <h3>{post.data.title}</h3>
    </a>

    <div class="mt-1.5 flex flex-wrap items-center gap-x-2 text-muted-foreground">
      <svg
        class="size-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <rect x="3.5" y="5" width="17" height="15" rx="2.5"></rect>
        <path d="M8 3v4M16 3v4M3.5 10h17"></path>
      </svg>
      {date.getTime() > 0 && (
        <time class="text-sm" datetime={date.toISOString()}>{formatDate(date)}</time>
      )}
      {tags.length > 0 && <span class="text-sm">· {tags.join(' / ')}</span>}
    </div>

    {excerpt && <p>{excerpt}{excerpt.length >= 96 ? '…' : ''}</p>}

    <span class="post-cta">阅读全文 <span aria-hidden="true">↗</span></span>
  </div>
</li>
