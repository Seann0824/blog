---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop: _noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();
const t = useTranslations(locale);
---

<footer
  class:list={["app-layout shrink-0", className]}
  {...attrs}
>
  <div
    class="font-gothic flex flex-col items-center justify-between py-6 text-xs tracking-[0.12em] sm:border-t sm:border-border sm:flex-row-reverse"
  >
    <Socials />
    <div class="my-1 flex flex-row items-center justify-center whitespace-nowrap">
      {
        config.features.showArchives && (
          <>
            <a
              href={getRelativeLocaleUrl(locale, "archives")}
              class="hover:text-accent transition-colors"
            >
              {t.nav.archives}
            </a>
            <span class="mx-1.5">&nbsp;|&nbsp;</span>
          </>
        )
      }
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span class="max-sm:hidden">{t.footer.allRightsReserved}</span>
    </div>
  </div>
</footer>
