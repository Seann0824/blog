---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();
const t = useTranslations(locale);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border font-gothic flex flex-col items-center justify-between border-t py-8 text-xs tracking-[0.12em] sm:flex-row-reverse sm:py-6"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      {
        config.features.showArchives && (
          <>
            <a
              href={getRelativeLocaleUrl(locale, "archives")}
              class="hover:text-accent transition-colors"
            >
              {t.nav.archives}
            </a>
            <span class="mx-2">&nbsp;|&nbsp;</span>
          </>
        )
      }
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t.footer.allRightsReserved}</span>
    </div>
  </div>
</footer>
