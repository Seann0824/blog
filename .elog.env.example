# 复制成 .elog.env 后填入自己的值；.elog.env 不入库
# 飞书开放平台 → 创建企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 知识库（wiki）：地址栏 /wiki/space/<这一段就是 wikiId>
FEISHU_WIKI_ID=7xxxxxxxxxxxxxxxxx

# 如果 type=space，就改用文件夹 token（云空间文件夹 URL 里的那一串）
# FEISHU_FOLDER_TOKEN=fldcnxxxxxxxxxxxx

FEISHU_SOURCE_TYPE=wiki

# 站点信息（构建时用）
SITE_NAME=Sean 的博客
SITE_TAGLINE=记录一些想法、工具与生活。
SITE_URL=https://blog.example.com
