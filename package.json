{
  "name": "sean-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -R dist/pagefind public/",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "elog sync -e .elog.env",
    "sync:clean": "elog clean",
    "sync:full": "elog sync -e .elog.env --full-cache",
    "postinstall": "node scripts/patch-feishux.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@elog/cli": "^0.14.7",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
